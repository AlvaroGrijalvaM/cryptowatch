<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cryptowatch.watch">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.vibrate"/>
    
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="CryptoWatch Watch"
        android:theme="@style/Theme.CryptoWatch.Watch">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        
        <!-- Receptor de mensajes desde el teléfono -->
        <receiver
            android:name=".AlertReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.cryptowatch.mobile.ALERT_TRIGGERED"/>
            </intent-filter>
        </receiver>
        
    </application>
</manifest>